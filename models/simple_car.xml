<mujoco model="simple_car">
  <option gravity="0 0 -9.81" timestep="0.005"/>

  <default>
    <geom contype="1" conaffinity="1" condim="3"/>
  </default>

  <worldbody>
    <!-- <light pos="0 0 5" dir="0 0 -1"/>
    <geom name="ground" type="plane" size="20 20 0.1" friction="1.0 0.05 0.05" rgba="0.7 0.7 0.7 1"/> -->

    <!-- Edgar dimensions (m): length=4.973, width=1.941, height=2.320 -->
    <!-- Chassis origin is at vehicle CG; wheels placed using a/b and track -->
    <body name="chassis" pos="0 0 1.49">
      <freejoint name="root"/>
      <geom name="chassis" type="box" size="2.4865 0.9705 1.16" mass="2520" rgba="0.2 0.4 0.8 1"/>

      <!-- wheelbase: a=1.484 (front), b=1.644 (rear); track: T_f=1.645 -->
      <!-- wheel radius=0.33, width=0.15 (update if you know R_w) -->
      <body name="steer" pos="1.484 0 -1.16">
        <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
        <!-- <joint name="steer_yaw" type="hinge" axis="0 0 1" range="-0.610865 0.610865"/> -->
        <body name="wheel_fl" pos="0 0.8225 0">
          <joint name="fl_spin" type="hinge" axis="0 1 0"/>
          <geom type="cylinder" size="0.33 0.15" euler="90 0 0" mass="40" friction="1.5 0.05 0.05" rgba="0.1 0.1 0.1 1"/>
        </body>
        <body name="wheel_fr" pos="0 -0.8225 0">
          <joint name="fr_spin" type="hinge" axis="0 1 0"/>
          <geom type="cylinder" size="0.33 0.15" euler="90 0 0" mass="40" friction="1.5 0.05 0.05" rgba="0.1 0.1 0.1 1"/>
        </body>
      </body>
      <body name="wheel_rl" pos="-1.644 0.8225 -1.16">
        <joint name="rl_spin" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.33 0.15" euler="90 0 0" mass="40" friction="1.5 0.05 0.05" rgba="0.1 0.1 0.1 1"/>
      </body>
      <body name="wheel_rr" pos="-1.644 -0.8225 -1.16">
        <joint name="rr_spin" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.33 0.15" euler="90 0 0" mass="40" friction="1.5 0.05 0.05" rgba="0.1 0.1 0.1 1"/>
      </body>
    </body>
  </worldbody>

  <tendon>
    <!-- One throttle signal applied equally to all wheel spin joints -->
    <fixed name="throttle_all">
      <joint joint="fl_spin" coef="0.25"/>
      <joint joint="fr_spin" coef="0.25"/>
      <joint joint="rl_spin" coef="0.25"/>
      <joint joint="rr_spin" coef="0.25"/>
    </fixed>
  </tendon>

  <actuator>
    <!-- Single speed control for all wheels (-1..1) -->
    <motor name="throttle" tendon="throttle_all" gear="200" ctrllimited="true" ctrlrange="-1 1"/>
  </actuator>
</mujoco>
