<mujoco model="simple_car">
  <option gravity="0 0 -9.81" timestep="0.005"/>

  <default>
    <geom contype="1" conaffinity="1" condim="3"/>
  </default>

  <worldbody>
    <!-- <light pos="0 0 5" dir="0 0 -1"/>
    <geom name="ground" type="plane" size="20 20 0.1" friction="1.0 0.05 0.05" rgba="0.7 0.7 0.7 1"/> -->

    <body name="chassis" pos="0 0 0.15">
      <freejoint name="root"/>
      <geom name="chassis" type="box" size="0.4 0.2 0.3" mass="10" rgba="0.2 0.4 0.8 1"/>

      <body name="wheel_fl" pos="0.3 0.24 -0.3">
        <joint name="fl_spin" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.08 0.04" euler="90 0 0" mass="1" friction="1.5 0.05 0.05" rgba="0.1 0.1 0.1 1"/>
      </body>
      <body name="wheel_fr" pos="0.3 -0.3 -0.3">
        <joint name="fr_spin" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.08 0.04" euler="90 0 0" mass="1" friction="1.5 0.05 0.05" rgba="0.1 0.1 0.1 1"/>
      </body>
      <body name="wheel_rl" pos="-0.3 0.3 -0.3">
        <joint name="rl_spin" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.08 0.04" euler="90 0 0" mass="1" friction="1.5 0.05 0.05" rgba="0.1 0.1 0.1 1"/>
      </body>
      <body name="wheel_rr" pos="-0.3 -0.3 -0.3">
        <joint name="rr_spin" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.08 0.04" euler="90 0 0" mass="1" friction="1.5 0.05 0.05" rgba="0.1 0.1 0.1 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="drive_rl" joint="rl_spin" gear="40" ctrllimited="true" ctrlrange="-1 1"/>
    <motor name="drive_rr" joint="rr_spin" gear="40" ctrllimited="true" ctrlrange="-1 1"/>
  </actuator>
</mujoco>