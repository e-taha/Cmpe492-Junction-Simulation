<mujoco model="simple_car">
  <option gravity="0 0 -9.81" timestep="0.005"/>

  <default>
    <geom contype="1" conaffinity="1" condim="3"/>
    <!-- Edgar steering range from vehicle_parameters_edgar.yaml -->
    <default class="steering">
      <joint type="hinge" axis="0 0 1" limited="true"
             frictionloss="1.0" damping="5.0" armature="0.1"
             range="-35 35"/>
    </default>
    <default class="throttle">
      <joint type="hinge" axis="0 1 0"
             frictionloss="1.0" damping="1.0" armature="1.0" limited="false"/>
    </default>
  </default>

  <worldbody>
    <!-- Edgar dimensions (m): length=4.973, width=1.941, height=2.320              -->
    <!-- Tire: Bridgestone 235/50R18 → radius = 9in + 235×0.5mm = 0.346 m          -->
    <!-- CG height = wheel_radius(0.346) + chassis_half_height(0.987) = 1.333 m    -->
    <!-- chassis_half_height = (vehicle_height - wheel_radius) / 2                  -->
    <!--                     = (2.320 - 0.346) / 2 = 0.987 m                        -->
    <!-- a=1.484 (CG to front axle), b=1.644 (CG to rear axle)                     -->
    <!-- T_f=1.645 m -> half-track = 0.8225 m                                      -->
    <body name="chassis" pos="0 0 1.333">
      <freejoint name="root"/>
      <site name="imu" pos="0 0 0"/>
      <!-- Reference marker at roof height (2.32m above ground = 0.987m above CG) -->
      <site name="roof_ref" pos="0 0 0.987" size="0.05" rgba="1 0 0 1"/>
      <geom name="chassis" type="box" size="2.4865 0.9705 0.987"
            mass="2400" rgba="0.2 0.4 0.8 1"/>

      <!-- Virtual bicycle-model steering reference at front axle centre.      -->
      <!-- Controlled by the steering actuator; fl/fr are slaved via Ackermann -->
      <body name="steering_wheel" pos="1.484 0 -0.987">
        <joint class="steering" name="steering_wheel"/>
        <geom type="cylinder" size="0.01 0.01" mass="0.01" rgba="0 0 0 0" contype="0" conaffinity="0"/>
      </body>

      <!-- Front-left wheel -->
      <body name="wheel_fl" pos="1.484 0.8225 -0.987">
        <joint class="steering" name="wheel_fl_steering"/>
        <joint class="throttle" name="fl_spin"/>
        <geom type="cylinder" size="0.346 0.15" euler="90 0 0" mass="30"
              friction="1.5 0.05 0.05" rgba="0.1 0.1 0.1 1"/>
      </body>

      <!-- Front-right wheel -->
      <body name="wheel_fr" pos="1.484 -0.8225 -0.987">
        <joint class="steering" name="wheel_fr_steering"/>
        <joint class="throttle" name="fr_spin"/>
        <geom type="cylinder" size="0.346 0.15" euler="90 0 0" mass="30"
              friction="1.5 0.05 0.05" rgba="0.1 0.1 0.1 1"/>
      </body>

      <!-- Rear-left wheel -->
      <body name="wheel_rl" pos="-1.644 0.8225 -0.987">
        <joint class="throttle" name="rl_spin"/>
        <geom type="cylinder" size="0.346 0.15" euler="90 0 0" mass="30"
              friction="1.5 0.05 0.05" rgba="0.1 0.1 0.1 1"/>
      </body>

      <!-- Rear-right wheel -->
      <body name="wheel_rr" pos="-1.644 -0.8225 -0.987">
        <joint class="throttle" name="rr_spin"/>
        <geom type="cylinder" size="0.346 0.15" euler="90 0 0" mass="30"
              friction="1.5 0.05 0.05" rgba="0.1 0.1 0.1 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- Position-controlled steering drives the virtual bicycle-model wheel   -->
   <position name="steering" joint="steering_wheel" kp="5000"  ctrlrange="-1 1"/>
    <!-- Velocity-independent throttle coupled equally to all four wheels      -->
    <motor name="throttle" tendon="throttle_all" gear="2520"
           ctrllimited="true" ctrlrange="0 1"/>
    <!-- Velocity-proportional brake: f = -kv × ctrl × tendon_vel             -->
    <!-- kv=95 → 3.5 m/s² deceleration at 40 km/h (EDGAR a_min spec)          -->
    <!-- Force → 0 as v → 0, so vehicle cannot reverse under braking            -->
    <damper name="brake" tendon="throttle_all" kv="95" ctrlrange="0 1"/>
  </actuator>

  <equality>
    <joint joint1="wheel_fl_steering" joint2="steering_wheel" polycoef="0 -1 0 0"/>
    <joint joint1="wheel_fr_steering" joint2="steering_wheel" polycoef="0 -1 0 0"/>
  </equality>

  <tendon>
    <fixed name="throttle_all">
      <joint joint="fl_spin" coef="0.25"/>
      <joint joint="fr_spin" coef="0.25"/>
      <joint joint="rl_spin" coef="0.25"/>
      <joint joint="rr_spin" coef="0.25"/>
    </fixed>
  </tendon>

  <sensor>
    <gyro          name="gyro"          site="imu"/>
    <velocimeter   name="velocimeter"   site="imu"/>
    <accelerometer name="accelerometer" site="imu"/>
  </sensor>
</mujoco>
